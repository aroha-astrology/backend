# payload) is NOT excluded here and stays tracked.
/data/gita-audio/

.env
.env.*
!.env.example

# service account keys — never commit credentials.
# note: keys downloaded from the GCP IAM console are named <project>-<hex>.json
# and do NOT match the pattern below — keep all keys inside secrets/.
secrets/
*firebase-adminsdk*.json
*.pem
*.p12

*.log
npm-debug.log*

.DS_Store
.vscode/
.idea/

